{"code":"export const RSA_FALSE_TAGS = new Set([\"enterprise-fyi\", \"enterprise-duplicate\"]);\nexport const hasRsaFalseTag = (tags) => (tags ?? []).some((t) => RSA_FALSE_TAGS.has(t.trim().toLowerCase()));\nexport function effectiveRsa(r) {\n\tif (r.rsa_override === true) return {\n\t\tvalue: \"required\",\n\t\tsource: \"manual\"\n\t};\n\tif (r.rsa_override === false) return {\n\t\tvalue: \"not_required\",\n\t\tsource: \"manual\"\n\t};\n\tif (hasRsaFalseTag(r.tags)) return {\n\t\tvalue: \"not_required\",\n\t\tsource: \"tag\"\n\t};\n\treturn {\n\t\tvalue: \"required\",\n\t\tsource: \"default\"\n\t};\n}\n","map_data_url":"data:application/json;charset=utf-8;base64,","imports":[],"is_boundary":false,"kind":"","require_map":[],"css_exports":[],"fs_allow":[],"watch_files":[]}