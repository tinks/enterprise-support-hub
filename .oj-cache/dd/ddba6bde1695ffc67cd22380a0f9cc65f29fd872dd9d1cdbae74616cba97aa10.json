{"code":"// Owner display normalization.\n// \"Tine Saint-Ghislain\" → \"Tine\", \"Kristina Bodurova\" → \"Kristina\".\nexport function normalizeOwner(owner) {\n\tif (!owner) return owner;\n\tconst s = String(owner).trim();\n\tif (/^tine(\\s|$)/i.test(s)) return \"Tine\";\n\tif (/^kristina(\\s|$)/i.test(s)) return \"Kristina\";\n\treturn owner;\n}\n","map_data_url":"data:application/json;charset=utf-8;base64,","imports":[],"is_boundary":false,"kind":"","require_map":[],"css_exports":[],"fs_allow":[],"watch_files":[]}