{"code":"export const WINDOW_LABELS = {\n\t\"7d\": \"Last 7 days\",\n\t\"30d\": \"Last 30 days\",\n\t\"90d\": \"Last 90 days\",\n\tmonth: \"This month\",\n\tlast_month: \"Last month\",\n\tall: \"All time\"\n};\nexport const WINDOW_CAPTIONS = {\n\t\"7d\": \"resolved in the last 7 days\",\n\t\"30d\": \"resolved in the last 30 days\",\n\t\"90d\": \"resolved in the last 90 days\",\n\tmonth: \"resolved this month\",\n\tlast_month: \"resolved last month\",\n\tall: \"resolved (all time)\"\n};\n// Bounded window range. endMs is exclusive; null means \"no bound\".\nexport function windowRange(w, now) {\n\tif (w === \"all\") return {\n\t\tstartMs: null,\n\t\tendMs: null\n\t};\n\tif (w === \"month\") {\n\t\treturn {\n\t\t\tstartMs: new Date(now.getFullYear(), now.getMonth(), 1).getTime(),\n\t\t\tendMs: null\n\t\t};\n\t}\n\tif (w === \"last_month\") {\n\t\treturn {\n\t\t\tstartMs: new Date(now.getFullYear(), now.getMonth() - 1, 1).getTime(),\n\t\t\tendMs: new Date(now.getFullYear(), now.getMonth(), 1).getTime()\n\t\t};\n\t}\n\tconst days = w === \"7d\" ? 7 : w === \"30d\" ? 30 : 90;\n\treturn {\n\t\tstartMs: now.getTime() - days * 24 * 60 * 60 * 1e3,\n\t\tendMs: null\n\t};\n}\nexport function windowStartMs(w, now) {\n\treturn windowRange(w, now).startMs;\n}\nexport function rowClosedAtMs(r) {\n\tif (r.intercom_closed_at) {\n\t\tconst t = Date.parse(r.intercom_closed_at);\n\t\tif (!Number.isNaN(t)) return t;\n\t}\n\tconst s = r.raw_payload?.statistics?.last_close_at;\n\tif (typeof s === \"number\" && s > 0) return s * 1e3;\n\treturn null;\n}\n","map_data_url":"data:application/json;charset=utf-8;base64,","imports":[],"is_boundary":false,"kind":"","require_map":[],"css_exports":[],"fs_allow":[],"watch_files":[]}